# Server-only runtime: Supabase transaction pooler for hosted environments.
# Remote production URLs require sslmode=verify-full (and sslrootcert when needed).
DATABASE_URL=
# Optional PEM root CA for hosted runtimes; keep sslmode=verify-full and omit sslrootcert.
DATABASE_CA_CERT=
# Exact browser origin. HTTPS is mandatory in production.
# On Vercel Preview only, omission uses the platform-provided deployment hostname.
APP_ORIGIN=
# Shared server-only 32-byte random secret, encoded as 64 hex characters.
AUTH_RATE_LIMIT_SECRET=
# Optional live messaging, after reviewed Supabase private Realtime setup.
# All three stay server-side. Only the publishable key and short-lived capability reach the browser.
SUPABASE_REALTIME_URL=
SUPABASE_PUBLISHABLE_KEY=
# Single-line private ES256 P-256 JWK, with the kid imported/activated in Supabase.
MERKAT_REALTIME_SIGNING_JWK=
# Optional browser push. Copy the same keys to the reminder worker environment.
MERKAT_PUSH_PUBLIC_KEY=
MERKAT_PUSH_PRIVATE_KEY=
MERKAT_PUSH_SUBJECT=
# Optional in-app reminder scheduler credential, at least 32 characters.
CRON_SECRET=
