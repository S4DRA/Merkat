# Reference only. Next loads apps/web/.env.local, not this root example.
# Export CLI variables explicitly before running database commands.
DATABASE_URL=
DIRECT_URL=
APP_ORIGIN=
AUTH_RATE_LIMIT_SECRET=
SUPABASE_REALTIME_URL=
SUPABASE_PUBLISHABLE_KEY=
MERKAT_REALTIME_SIGNING_JWK=
# Optional HTTPS browser push; private key and subject stay server-side on worker.
MERKAT_PUSH_PUBLIC_KEY=
MERKAT_PUSH_PRIVATE_KEY=
MERKAT_PUSH_SUBJECT=
# Optional hosted scheduler alternative for in-app reminders; at least 32 characters.
CRON_SECRET=
